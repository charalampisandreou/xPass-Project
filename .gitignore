# =============================================================================
# xPass .gitignore: allow-list
#
# Everything in the repository root is ignored, except the entries listed in
# section 1. To publish a new top-level file or folder (for example a README),
# add a matching "!" line there.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Repository root: ignore everything except these
# -----------------------------------------------------------------------------
/*

!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/run_all.py
!/run_files/
!/src/
!/docs/

# Local-only content stays out by default:
#   data/       raw StatsBomb downloads and processed datasets (~9 GB)
#   models/     trained models, reports, datasets and figures
#   notebooks/, Learning/, project-history.txt, virtual environments, ...


# -----------------------------------------------------------------------------
# 2. Inside the allowed folders: generated files that should never be committed
# -----------------------------------------------------------------------------

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Data and model artifacts, in case one is saved next to the code by mistake
*.json
*.csv
*.parquet
*.joblib
*.pkl
*.onnx
*.png

# Exception: figures used by the README live in docs/
!/docs/*.png

# Jupyter checkpoints
.ipynb_checkpoints/

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
