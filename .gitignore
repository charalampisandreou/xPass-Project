# ------------------------------------------------------------
# Whitelist approach: ignore everything at the repo root,
# then explicitly allow only what should be on GitHub.
# ------------------------------------------------------------

# Ignore everything at the repo root
/*

# Allow only these
!/.gitignore
!/src/
!/run_files/

# Optional: uncomment if you add these later
# !/README.md
# !/requirements.txt

# ------------------------------------------------------------
# Junk to ignore inside the allowed folders
# ------------------------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/

# OS / IDE junk
.DS_Store
Thumbs.db
.vscode/

# Data files and serialized artifacts (in case any end up in src/ or run_files/)
*.json
*.csv
*.parquet
*.joblib
*.pkl
*.onnx